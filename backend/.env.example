# --- Agent loop ---
AGENT_MAX_STEPS=6
WORKSPACE_DIR=

# --- Terminal: local | modal ---
CLI_MODE=local

# Auth can come from ~/.modal.toml via MODAL_PROFILE, or from these env vars.
# Environment variables take precedence over ~/.modal.toml.
MODAL_PROFILE=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=main
# Named image in that workspace (not a workspace/image dashboard path).
MODAL_IMAGE=main
MODAL_APP_NAME=workelate-cli
# Sandbox lifetime / idle shutdown (seconds); leave idle empty to disable.
MODAL_TIMEOUT=86400
MODAL_IDLE_TIMEOUT=
# Optional cwd inside the sandbox; empty = the image's default workdir.
MODAL_WORKDIR=
# Used when a fallback account has no named image: "debian_slim" (default) or a
# registry image such as "python:3.12-slim".
MODAL_FALLBACK_IMAGE=debian_slim

# --- Modal account fallbacks ---
# Tried in order when the primary account hits a limit, loses auth, or its
# sandbox cannot be created/executed. Each account needs a token pair
# (TOKEN_ID + TOKEN_SECRET) or a PROFILE from ~/.modal.toml.
# All accounts share MODAL_ENVIRONMENT / MODAL_IMAGE / MODAL_APP_NAME /
# MODAL_WORKDIR; only the credentials change.
MODAL_2_TOKEN_ID=
MODAL_2_TOKEN_SECRET=
MODAL_2_PROFILE=

MODAL_3_TOKEN_ID=
MODAL_3_TOKEN_SECRET=
MODAL_3_PROFILE=

MODAL_4_TOKEN_ID=
MODAL_4_TOKEN_SECRET=
MODAL_4_PROFILE=

# --- LLM (OpenAI-compatible: base URL + API key + model id) ---
# Primary provider
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Fallback providers (optional; tried in order when the previous one fails).
# Leave BASE_URL/MODEL empty to reuse the primary values.
LLM_2_API_KEY=
LLM_2_BASE_URL=
LLM_2_MODEL=

LLM_3_API_KEY=
LLM_3_BASE_URL=
LLM_3_MODEL=

LLM_4_API_KEY=
LLM_4_BASE_URL=
LLM_4_MODEL=

LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
LLM_RETRIES=2

