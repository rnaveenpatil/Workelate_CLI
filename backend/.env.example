# --- Agent loop ---
AGENT_MAX_STEPS=6
WORKSPACE_DIR=

# --- Terminal: local | daytona ---
CLI_MODE=local

DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Reuse a sandbox by id/name; empty = reuse a running one or create a new one.
DAYTONA_SANDBOX_ID=
DAYTONA_WORKDIR=/home/daytona

# --- LLM (empty on purpose) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- GitHub workspace (optional, read-only listing) ---
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
