# --- Agent loop ---
AGENT_MAX_STEPS=6
WORKSPACE_DIR=

# --- Terminal: local | remote ---
CLI_MODE=local
CLI_REMOTE_URL=
CLI_TOKEN=
# Private Codespaces ports: paste the codespace's own $GITHUB_TOKEN (ghu_...)
# or make the port public in the Ports tab.
CLI_GITHUB_TOKEN=
CLI_REMOTE_TIMEOUT=45

# --- Sandbox: isolate every remote task in a Docker container ---
# Empty = run directly in the remote workspace (no isolation).
SANDBOX_CONTAINER=
SANDBOX_WORKDIR=/workspace
SANDBOX_PYTHON=python3
# e.g. 1000:1000 for a rootless Docker bind mount owned by uid 1000
SANDBOX_USER=

# --- LLM (empty on purpose) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- GitHub workspace (optional, read-only listing) ---
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
